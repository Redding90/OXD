&НаСервере
Процедура СоздатьЭлементыУведомлениеДниОтпуска()
	НоваяКоманда = Команды.Добавить("УведомитьДниОтпуска");
	НоваяКоманда.Заголовок = "Уведомление дни отпуска";
	НоваяКоманда.Действие = "УведомитьДниОтпуска";
	НовыйЭлемент = Элементы.Добавить("КнопкаУведомитьДниОтпуска", Тип("КнопкаФормы"), Элементы.Уведолмения);
	НовыйЭлемент.Заголовок = "Уведомление дни отпуска";
	НовыйЭлемент.ИмяКоманды = "УведомитьДниОтпуска";
КонецПроцедуры

