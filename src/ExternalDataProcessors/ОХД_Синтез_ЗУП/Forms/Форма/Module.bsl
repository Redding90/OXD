&НаКлиенте
Процедура ОткрытьЖР(СобытиеЖурналаРегистрации)
	
	Отбор = Новый Структура;
	Отбор.Вставить("СобытиеЖурналаРегистрации", СобытиеЖурналаРегистрации);
	Отбор.Вставить("ДатаНачала",                НачалоДня(ТекущаяДата()));
	Отбор.Вставить("ДатаОкончания",             ТекущаяДата());
	
	ОткрытьФорму("Обработка.ЖурналРегистрации.Форма", Отбор, ЭтаФорма);
	
КонецПроцедуры


