Функция ПривестиКШаблонуТел(Тел)
	
	Если Лев(Тел,1) = "7" Тогда
	
		Тел = "+" + Тел;	
	
	КонецЕсли;
	
	Тел = СтрЗаменить(Тел," ","");
	Тел = СтрЗаменить(Тел,"(","");
	Тел = СтрЗаменить(Тел,")",""); 
	Тел = СтрЗаменить(Тел,"-","");
	
Возврат Тел;

