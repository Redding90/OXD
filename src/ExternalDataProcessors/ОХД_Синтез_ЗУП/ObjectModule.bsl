Функция BirthDay_ИнициализироватьТаблицуРезультата()
	
	сРез = Новый ТаблицаЗначений;
	
	КавлификаторДаты = Новый КвалификаторыДаты(ЧастиДаты.Дата);
	КавлификаторСтроки = Новый КвалификаторыСтроки(300,ДопустимаяДлина.Переменная);
	
	сРез.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	сРез.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	сРез.Колонки.Добавить("ДатаРождения", Новый ОписаниеТипов("Дата",,,,,КавлификаторДаты));
	сРез.Колонки.Добавить("ФИОПолные", Новый ОписаниеТипов("Строка",,,,КавлификаторСтроки));
	
	Возврат сРез;
	
КонецФункции	

Процедура BirthDay_СотрудникиСБлижайщимиДнямиРождений(СобытиеЖР, сРез)
	
	НапоминатьЗа = RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("BirthDay_НапомнитьОДняхРожденияхСотрудников"); 
	ПроверяемаяДатаДняРождения = ТекущаяДатаСеанса() + (НапоминатьЗа * 86400); 
	
	ПараметрыПолучения = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолучения.ОкончаниеПериода = ПроверяемаяДатаДняРождения;
	ПараметрыПолучения.КадровыеДанные = "Организация,ФИОПолные,ДатаРождения,ДатаУвольнения";    
	
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолучения.Отборы,"ДатаУвольнения", "=", Дата(1, 1, 1));
	
	ТаблицаСотрудников = КадровыйУчет.СотрудникиОрганизации(Ложь, ПараметрыПолучения);
	
	ЗаписьЖР(СобытиеЖР, "Проверяемая дата:" + ПроверяемаяДатаДняРождения);

	ДеньРождения = День(ПроверяемаяДатаДняРождения);
	МесяцРождения = Месяц(ПроверяемаяДатаДняРождения);
		
	Для каждого ДанныеСотрудника Из ТаблицаСотрудников Цикл 
		
		Если  ДеньРождения = День(ДанныеСотрудника.ДатаРождения) 
			И МесяцРождения = Месяц(ДанныеСотрудника.ДатаРождения) и ЗначениеЗаполнено(ДанныеСотрудника.ДатаРождения) Тогда		
			СтрокаРезультата = сРез.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРезультата,ДанныеСотрудника); 
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

