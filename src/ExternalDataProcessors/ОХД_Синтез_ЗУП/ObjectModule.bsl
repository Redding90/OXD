		СтруктураКИ.Вставить("КодГорода",     ТелефонКодГорода);
		СтруктураКИ.Вставить("НомерТелефона", ТелефонНомер);
		
		Тип = Перечисления.ТипыКонтактнойИнформации.Телефон; 
