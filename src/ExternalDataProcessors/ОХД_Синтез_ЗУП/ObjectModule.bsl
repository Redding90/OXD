Процедура ЗаполнитьНовыхСотрудников(Организация) Экспорт
	
	СобытиеЖР = "ХД.ЗаполнитьНовыхСотрудников";
	
	ЗаписьЖР(СобытиеЖР, "Начало обработки");
	
	ЗаполнитьНовыхСотрудниковВыполнить(СобытиеЖР, Организация);
	
	ЗаписьЖР(СобытиеЖР, "Окончание обработки");
	
КонецПроцедуры

Процедура ЗаполнитьНовыхСотрудниковВыполнить(СобытиеЖР, Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",         Организация);
	Запрос.УстановитьПараметр("ФильтрОрганизация",   ЗначениеЗаполнено(Организация));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.Наименование КАК СотрудникСтрока,
	|	ЕСТЬNULL(Сотрудники.ФизическоеЛицо.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаРождения,
	|	ЕСТЬNULL(МИНИМУМ(ТКД.ДатаПриема), ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаВыхода,
	|	Истина Как СозданОбработкойНачальногоЗаполнения
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		Левое СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТКД
	|		ПО Сотрудники.Ссылка = ТКД.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ZUPC_НовыеCотрудники КАК НовыеCотрудники
	|		ПО Сотрудники.Ссылка = НовыеCотрудники.Сотрудник
	|			ИЛИ Сотрудники.Наименование = НовыеCотрудники.СотрудникСтрока
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|	И ЕстьNULL(ТКД.ДатаУвольнения, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И Сотрудники.ГоловнаяОрганизация = &Организация
	|	И НовыеCотрудники.СотрудникСтрока ЕСТЬ NULL
	|СГРУППИРОВАТЬ ПО
	|	Сотрудники.Ссылка,
	|	Сотрудники.Наименование,
	|	Сотрудники.ФизическоеЛицо.ДатаРождения
	|УПОРЯДОЧИТЬ ПО
	|	СотрудникСтрока";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		ЗаписьЖР(СобытиеЖР, "Новых записей не найдено");
		ОбщегоНазначения.СообщитьПользователю("Новых записей не найдено.");
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	КоличествоДобавлено = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.СотрудникСтрока) Тогда
			Продолжить;
		КонецЕсли;
		
		МЗ = РегистрыСведений.ZUPC_НовыеCотрудники.СоздатьМенеджерЗаписи();  
		ЗаполнитьЗначенияСвойств(МЗ, Выборка, "СотрудникСтрока,Сотрудник,ДатаВыхода,ДатаРождения,СозданОбработкойНачальногоЗаполнения");
		//МЗ.СотрудникСтрока                        = Выборка.СотрудникСтрока;
		//МЗ.Сотрудник                              = Выборка.Сотрудник;
		//МЗ.ДатаВыхода                             = Выборка.ДатаВыхода;
		//МЗ.ДатаРождения                           = Выборка.ДатаРождения;
		//МЗ.СозданОбработкойНачальногоЗаполнения   = Истина;
		МЗ.Записать(Истина);
		
		КоличествоДобавлено = КоличествоДобавлено + 1;
		
	КонецЦикла;
	
	ОбщегоНазначения.СообщитьПользователю("Заполнить Новых Сотрудников: добавлено записей — " + КоличествоДобавлено);
	ЗаписьЖР(СобытиеЖР, "Добавлено записей: " + КоличествоДобавлено);
	
КонецПроцедуры

//ОбновитьМестаИОфисы
Процедура ОбновитьМестаИОфисы()
	СобытиеЖР = "ХД.ОбновитьМестаИОфисы";
	ЗаписьЖР(СобытиеЖР, "Начало обработки");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Регистр.СотрудникСтрока КАК СотрудникСтрока,
	|	Регистр.Сотрудник КАК Сотрудник,
	|	Регистр.НомерМеста КАК СтарыйНомерМеста,
	|	Регистр.Офис КАК СтарыйОфис,
	|	Справочник.НомерМеста КАК НовыйНомерМеста,
	|	Справочник.Офис КАК НовыйОфис
	|ИЗ
	|	РегистрСведений.ZUPC_НовыеCотрудники КАК Регистр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Справочник
	|		ПО Регистр.Сотрудник = Справочник.Ссылка
	|ГДЕ
	|	Справочник.НомерМеста <> Регистр.НомерМеста
	|			ИЛИ Справочник.Офис <> Регистр.Офис
	|
	|УПОРЯДОЧИТЬ ПО
	|	Регистр.СотрудникСтрока";
	Результат = Запрос.Выполнить();
	Выборка   = Результат.Выбрать();
	СчетчикОбновленных = 0;
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.СотрудникСтрока) Тогда
			ЗаписьЖР(СобытиеЖР, "Пропуск: пустое поле СотрудникСтрока для сотрудника: " + Строка(Выборка.Сотрудник));
			Продолжить;
		КонецЕсли;
		НаборЗаписей = РегистрыСведений.ZUPC_НовыеCотрудники.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СотрудникСтрока.Установить(Выборка.СотрудникСтрока);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда
			ЗаписьЖР(СобытиеЖР, "Запись не найдена для сотрудника: " + Строка(Выборка.Сотрудник));
			Продолжить;
		КонецЕсли;
		ЗаписьЖурналаРегистрации(
		"ХД.ОбновитьМестаИОфисы",
		УровеньЖурналаРегистрации.Информация,
		,
		Выборка.Сотрудник,
		"Старый НомерМеста: " + Строка(Выборка.СтарыйНомерМеста)
		+ "; Старый Офис: " + Строка(Выборка.СтарыйОфис));
		ЗаписьРегистра = НаборЗаписей[0];
		ЗаписьРегистра.НомерМеста = Выборка.НовыйНомерМеста;
		ЗаписьРегистра.Офис = Выборка.НовыйОфис;
		НаборЗаписей.Записать(Истина);
		СчетчикОбновленных = СчетчикОбновленных + 1;
	КонецЦикла;
	Сообщить("Обновлено " + СчетчикОбновленных + " записей");
	ЗаписьЖР(СобытиеЖР, "Обновлено записей: " + СчетчикОбновленных);
	ЗаписьЖР(СобытиеЖР, "Окончание обработки");
КонецПроцедуры

#Область МониторингОшибокЖурналаРегистрации

// Проверяет журнал регистрации за период с последней обработки и отправляет найденные ошибки в eXpress.
// После успешного выполнения обновляет дату начала следующего мониторинга в дополнительной константе.
//
Процедура МониторингОшибокЖР() Экспорт
	СобытиеЖР = "ХД.ZUPC_МониторингОшибокЖР";
	ЗаписьЖР(СобытиеЖР, "Начало обработки");
	Попытка
		ДатаНачала = ПолучитьДатуНачалаМониторингаОшибокЖР();
		Если ДатаНачала = Неопределено Тогда
			ЗаписьЖР(СобытиеЖР, "Дата начала не задана в доп. константе. Выполнение пропущено.");
			Возврат;
		КонецЕсли;
		ДатаОкончания = ТекущаяДата();
		Если ДатаНачала >= ДатаОкончания Тогда
			ЗаписьЖР(СобытиеЖР, "Дата начала больше или равна текущей дате. Выполнение пропущено.");
			Возврат;
		КонецЕсли;
		ОшибкиЖР = ПолучитьОшибкиЖурналаРегистрации(ДатаНачала, ДатаОкончания);    
		Если ОшибкиЖР.Количество() = 0 Тогда
			Возврат;	
		КонецЕсли;
		Сообщения = СформироватьСообщенияМониторингаОшибокЖР(ДатаНачала, ДатаОкончания, ОшибкиЖР);
		Для Каждого Сообщение Из Сообщения Цикл
			ОповеститьExpress(Сообщение);
		КонецЦикла;
		УстановитьДатуНачалаМониторингаОшибокЖР(ДатаОкончания);
		ЗаписьЖР(СобытиеЖР, "Окончание обработки");
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖР(СобытиеЖР, ОписаниеОшибки, , Ложь, , УровеньЖурналаРегистрации.Предупреждение);
	КонецПопытки;
КонецПроцедуры

Функция ПолучитьОшибкиЖурналаРегистрации(ДатаНачала, ДатаОкончания)
	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", ДатаНачала);
	Отбор.Вставить("ДатаОкончания", ДатаОкончания);
	Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
	ОшибкиЖР = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(ОшибкиЖР, Отбор, "Уровень, Дата, Событие, Комментарий, ПредставлениеДанных");
	Возврат ОшибкиЖР;
КонецФункции

Функция СформироватьСообщенияМониторингаОшибокЖР(ДатаНачала, ДатаОкончания, ОшибкиЖР)
	Сообщения = Новый Массив;
	Заголовок = СтрШаблон("Период: %1 - %2. Найдено ошибок: %3",
		Формат(ДатаНачала, "ДЛФ=DT"),
		Формат(ДатаОкончания, "ДЛФ=DT"),
		ОшибкиЖР.Количество());
	ТекущееСообщение = Заголовок;
	КоличествоПримеров = ?(ОшибкиЖР.Количество() < 10, ОшибкиЖР.Количество(), 10);
	Для Индекс = 0 По КоличествоПримеров - 1 Цикл
		СтрокаОшибки = ОшибкиЖР[Индекс];
		ОписаниеОшибки = СформироватьСтрокуОшибкиМониторингаОшибокЖР(СтрокаОшибки, Заголовок);
		Если СтрДлина(ТекущееСообщение) + СтрДлина(Символы.ПС) + СтрДлина(ОписаниеОшибки) > ЛимитДлиныСообщенияМониторингаОшибокЖР() Тогда
			Сообщения.Добавить(ТекущееСообщение);
			ТекущееСообщение = Заголовок + Символы.ПС + ОписаниеОшибки;
		Иначе
			ТекущееСообщение = ТекущееСообщение + Символы.ПС + ОписаниеОшибки;
		КонецЕсли;
	КонецЦикла;
	Сообщения.Добавить(ТекущееСообщение);
	Возврат Сообщения;
КонецФункции

Функция СформироватьСтрокуОшибкиМониторингаОшибокЖР(СтрокаОшибки, Заголовок)
	ОписаниеОшибки = СтрШаблон("%1 | %2",
		Формат(СтрокаОшибки.Дата, "ДЛФ=DT"),
		Строка(СтрокаОшибки.Событие));
	Если ЗначениеЗаполнено(СтрокаОшибки.Комментарий) Тогда
		ОписаниеОшибки = СтрШаблон("%1 | %2", ОписаниеОшибки, Лев(Строка(СтрокаОшибки.Комментарий), 2500));
	КонецЕсли;
	ОписаниеОшибки = НормализоватьТекстСообщенияМониторингаОшибокЖР(ОписаниеОшибки);
	ДоступнаяДлина = ЛимитДлиныСообщенияМониторингаОшибокЖР() - СтрДлина(Заголовок) - СтрДлина(Символы.ПС);
	Возврат Лев(ОписаниеОшибки, ДоступнаяДлина);
КонецФункции

Функция ЛимитДлиныСообщенияМониторингаОшибокЖР()
	Возврат 4000;
КонецФункции

Функция НормализоватьТекстСообщенияМониторингаОшибокЖР(ТекстСообщения)
	Если ТекстСообщения = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Текст = Строка(ТекстСообщения);
	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Текст = СтрЗаменить(Текст, Символ(160), " ");
	Возврат УдалитьУправляющиеСимволыМониторингаОшибокЖР(Текст);
КонецФункции

Функция УдалитьУправляющиеСимволыМониторингаОшибокЖР(Текст)
	Результат = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		КодСимволаТекста = КодСимвола(Текст, Индекс);
		Если КодСимволаТекста < 32 И КодСимволаТекста <> 10 Тогда
			Продолжить;
		КонецЕсли;
		Результат = Результат + Сред(Текст, Индекс, 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьДатуНачалаМониторингаОшибокЖР()
	ИмяКонстанты = ИмяКонстантыДатыНачалаМониторингаОшибокЖР();
	ДатаНачала = RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты(ИмяКонстанты, Ложь, Ложь);
	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(ДатаНачала) <> Тип("Дата") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДатаНачала;
КонецФункции

Процедура УстановитьДатуНачалаМониторингаОшибокЖР(ДатаНачала)
	ИмяКонстанты = ИмяКонстантыДатыНачалаМониторингаОшибокЖР();
	УстановитьПривилегированныйРежим(Истина);
	КонстантаСсылка = Справочники.ДополнительныеКонстанты.НайтиПоНаименованию(ИмяКонстанты, Истина);
	Если КонстантаСсылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	КонстантаОбъект = КонстантаСсылка.ПолучитьОбъект();
	КонстантаОбъект.Значения.Очистить();
	НоваяСтрока = КонстантаОбъект.Значения.Добавить();
	НоваяСтрока.Значение = ДатаНачала;
	КонстантаОбъект.Записать();
КонецПроцедуры

