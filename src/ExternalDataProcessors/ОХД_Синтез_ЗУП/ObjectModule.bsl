Процедура ВыполнитьКоманду(ИдентификаторКоманды = Неопределено, ОбъектыНазначения = Неопределено) Экспорт
	
	Попытка
			
		Если ИдентификаторКоманды = "Zoho_УведомлениеОНовомСотруднике" Тогда	
			
			   Zoho_УведомлениеОНовомСотруднике();
			   
		ИначеЕсли ИдентификаторКоманды = "ОтправитьПисьмоHTML" Тогда	   
			   
			   ОтправитьПисьмоHTML(); 
			   
		ИначеЕсли ИдентификаторКоманды = "ЗаполнитьВНовыхСотрудникахОфисиМесто" Тогда
			   
			   ЗаполнитьВНовыхСотрудникахОфисиМесто();
			
		ИначеЕсли ИдентификаторКоманды = "ЗагрузкаУчетнойИнофрмацииПользователя" Тогда
			   
			   ЗагрузкаУчетнойИнофрмацииПользователя(); 
			   
		ИначеЕсли ИдентификаторКоманды = "BirthDay_НапомнитьОДняхРожденияхСотрудников" Тогда	
			
			BirthDay_НапомнитьОДняхРожденияхСотрудников();
			
		ИначеЕсли ИдентификаторКоманды = "Sync_ИнформацияОСостоянииСинхронизацийКаждыйЧас" Тогда	
			
			Sync_ИнформацияОСостоянииСинхронизаций(Истина);
			
		ИначеЕсли ИдентификаторКоманды = "Sync_ИнформацияОСостоянииСинхронизацийУтром" Тогда	
			
			Sync_ИнформацияОСостоянииСинхронизаций(Ложь);		
			
		ИначеЕсли ИдентификаторКоманды = "ЗаписьЗарплатыNetЕжедневно" Тогда	
			
			ЗаписьЗарплатыNetЕжедневно();		
			
		ИначеЕсли ИдентификаторКоманды = "ОбновитьИнформациювSD" Тогда	
			
			ОбновитьИнформациювSD();  
			
		ИначеЕсли ИдентификаторКоманды = "ЗаполняемФизЛицоИзСотрудников" Тогда	
			
			ЗаполняемФизЛицоИзСотрудников();
		
		ИначеЕсли ИдентификаторКоманды = "ПеренестиБонусы" Тогда	
			
			ПеренестиБонусы();
			
		ИначеЕсли ИдентификаторКоманды = "Probation_УведомлениеОбОкончанииИспытательногоСрока" Тогда
			
			Probation_УведомлениеОбОкончанииИспытательногоСрока();	

		ИначеЕсли ИдентификаторКоманды = "OfferSalary_УведомлениеОПовышенииЗПИзОффера" Тогда
			
			OfferSalary_УведомлениеОПовышенииЗПИзОффера();

		ИначеЕсли ИдентификаторКоманды = "OfferPerformanceBonus_УведомлениеОБонусеИзОффера" Тогда
			
			OfferPerformanceBonus_УведомлениеОБонусеИзОффера();

		ИначеЕсли ИдентификаторКоманды = "OfferSignOnBonus_УведомлениеОБонусеИзОффера" Тогда
			
			OfferSignOnBonus_УведомлениеОБонусеИзОффера();
			
		ИначеЕсли ИдентификаторКоманды = "ЗаполнитьЛокациювДолжности" Тогда
			
			ЗаполнитьЛокациювДолжности();	
			
		ИначеЕсли ИдентификаторКоманды = "ЗагрузитьизЭксельТелефоны" Тогда
			
			ЗагрузитьизЭксельТелефоны();    
			
		ИначеЕсли ИдентификаторКоманды = "HREstablishmentExcel" Тогда
	
			HREstablishmentExcel();
			
		ИначеЕсли ИдентификаторКоманды = "ОтправитьHRИзменениеЗПНДФЛ" Тогда	
			
			ОтправитьHRИзменениеЗПНДФЛ();	    
			
		ИначеЕсли ИдентификаторКоманды = "ПолучитьТелефоныИзSD" Тогда		
			
			ПолучитьТелефоныИзSD();       
			
		ИначеЕсли ИдентификаторКоманды = "ВыровнятьМаскуТелефонов" Тогда	
			
			ВыровнятьМаскуТелефонов()   
			
		ИначеЕсли ИдентификаторКоманды = "ПолучитьIDИзSD" Тогда
			
			ПолучитьIDИзSD();
			
		ИначеЕсли ИдентификаторКоманды = "ПосмотретьТаблицаМонитораОбменаДанными" Тогда	
			
			ПосмотретьТаблицаМонитораОбменаДанными();
			
		ИначеЕсли ИдентификаторКоманды = "ВыполнитьПодставлениеФизЛицаВУчетнойИнформации" Тогда 
			
			ВыполнитьПодставлениеФизЛицаВУчетнойИнформации(); 
			
		ИначеЕсли ИдентификаторКоманды = "ЗаполнитьФизЛицоПоИмениВУчИнф" Тогда  
			
			ЗаполнитьФизЛицоПоИмениВУчИнф();     
			
		ИначеЕсли ИдентификаторКоманды = "ВыполнитьСверкуДанных" Тогда  	
			
			ВыполнитьСверкуДанных();
			
		ИначеЕсли  ИдентификаторКоманды = "ВыполнитьВыгрузкуУправленческойШтатки"	Тогда 
			
			ВыполнитьВыгрузкуУправленческойШтатки(); 

		ИначеЕсли ИдентификаторКоманды = "МониторингОшибокЖР" Тогда
			
			МониторингОшибокЖР();
				 
		ИначеЕсли  ИдентификаторКоманды = "ВыполнитьВыгрузкуПосадкиСотрудников"	Тогда		 
			
			ВыполнитьВыгрузкуПосадкиСотрудников();
			
		ИначеЕсли  ИдентификаторКоманды = "ЗаполнитьУчетныеДанныевРСУчетнаяИнформация"	Тогда		 
			
			ЗаполнитьУчетныеДанныевРСУчетнаяИнформация();                                            
			
		ИначеЕсли  ИдентификаторКоманды = "СравнитьТелефоныBBЭксель"	Тогда
			
			СравнитьТелефоныBBЭксель();

		ИначеЕсли ИдентификаторКоманды = "ОбновитьМестаИОфисы" Тогда
			
			ОбновитьМестаИОфисы();

		Иначе
			   
			ВызватьИсключение "Неизвестная команда: " + ИдентификаторКоманды;
			
		КонецЕсли;
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ОписаниеОшибки = ОписаниеОшибки();
		
		Тема = "ОХД. Синтаксическая ошибка команды: " + ИдентификаторКоманды;
		
		ТекстПисьма = "Возникли ошибки при выполнении команды: " + ИдентификаторКоманды + " 
		|
		|Описание ошибки: " + ОписаниеОшибки;
		
		ПолучателиПисьма =  RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("Рассылка_ОХД_ОповещениеОСинтаксическойОшибке_Получатели", Истина);
		
		
		ПолучателиПисьма = Новый Массив;
		
		ПараметрыПисьма = Новый Структура;
		ПараметрыПисьма.Вставить("Тема", Тема);
		ПараметрыПисьма.Вставить("Текст", ТекстПисьма);
		УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты; //ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("CRM_УчетнаяЗаписьЭлектроннойПочты") 
		ПараметрыПисьма.Вставить("УчетнаяЗапись", УчетнаяЗапись);
		ПараметрыПисьма.Вставить("ПолучателиПисьма", ПолучателиПисьма);
		ПараметрыПисьма.Вставить("Важность", Перечисления.ВариантыВажностиВзаимодействия.Высокая);
		
		УправлениеЭлектроннойПочтой.СоздатьИсходящееПисьмо(ПараметрыПисьма);
		
	КонецПопытки;
	
КонецПроцедуры   

