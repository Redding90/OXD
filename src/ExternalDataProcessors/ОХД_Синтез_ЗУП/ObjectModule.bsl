			Запрос.УстановитьТелоИзСтроки("", "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);   //"UTF-8"
			HTTPСоединение = Новый HTTPСоединение(Путь,,,,,,Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено));  //Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено)
			
			Ответ = HTTPСоединение.ВызватьHTTPМетод("PUT",Запрос);      
			
			Если Ответ.КодСостояния <> 2000 И Ответ.КодСостояния <> 200 Тогда   
				ЕстьОшибкиОтправки = ЕстьОшибкиОтправки + 1;
				РезультатСтрока =  Ответ.ПолучитьТелоКакСтроку();	
				Коммментарий = СтрШаблон("Ошибка обновление информации в SD. Ответ: %1", РезультатСтрока);
				ЗаписьЖурналаРегистрации(НСтр("ru = 'ОбновитьИнформациювSD'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, , эл.Сотрудник, Коммментарий);
			КонецЕсли;
		Исключение   
			ЕстьОшибкиОтправки = ЕстьОшибкиОтправки + 1;
			Сообщить(ОписаниеОшибки()); 
			Сообщить(сЛистИнфо); 
			Коммментарий = СтрШаблон("Ошибка обновление информации в SD. Причина: %1", 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'ОбновитьИнформациювSD'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , эл.Сотрудник, Коммментарий); 
			Продолжить
			//Возврат "Ошибка обмена";
			
		КонецПопытки;
	КонецЦикла;
	
	Если ЕстьОшибкиОтправки > 0 Тогда
		ОповеститьExpress(СтрШаблон("Ошибки обновления информации в SD. Подробности см. в ЖР. Количество: %1", ЕстьОшибкиОтправки));	
	КонецЕсли;
КонецФункции 

