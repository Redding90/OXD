Функция ПолучитьИННКПП(СтрокаИННКПП)
	
  мСтруктура = Новый Структура;
  	 
  ИННПОЗ  = СтрНайти(СтрокаИННКПП,"ИНН");
  ПОЗ = 10;
  ИНН = Сред(СтрокаИННКПП,ИННПОЗ+4,ПОЗ);
  мСтруктура.Вставить("ИНН",ИНН);

  КПППОЗ  = СтрНайти(СтрокаИННКПП,"КПП");
  ПОЗКПП = 9;
  КПП = Сред(СтрокаИННКПП,КПППОЗ+4,ПОЗКПП);
  мСтруктура.Вставить("КПП",КПП);
 Возврат мСтруктура;
КонецФункции // ПолучитьИННКПП()

Процедура  ОбновитьКИВнешнееСоединение(КодВладельцаДоговора,Вид, Значение,ВнешнееСоединение) 
	
	КонтрагнетНайден = ВнешнееСоединение.Справочники.Контрагенты.НайтиПоКоду(КодВладельцаДоговора);
	
	НаборЗаписей = ВнешнееСоединение.РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(КонтрагнетНайден);  
	НаборЗаписей.Прочитать();
	
	Для каждого эл Из НаборЗаписей  Цикл
		Если ВнешнееСоединение.String(эл.Вид) = Вид Тогда
				эл.Представление = Значение	
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписей.Записать();	
	
КонецПроцедуры

Функция  ПолучитьКИВнешнееСоединение(КодВладельцаДоговора,ВнешнееСоединение)

	Запрос = ВнешнееСоединение.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|КонтактнаяИнформация.Объект КАК Объект,
	|ПРЕДСТАВЛЕНИЕ(КонтактнаяИнформация.Тип) КАК Тип,
	|ПРЕДСТАВЛЕНИЕ(КонтактнаяИнформация.Вид) КАК Вид,
	|КонтактнаяИнформация.Представление КАК Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект.Код = &Код";
	
	Запрос.УстановитьПараметр("Код",КодВладельцаДоговора);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если  РезультатЗапроса.Количество()=0 Тогда
		  РезультатЗапроса = Неопределено;
	КонецЕсли;
	
    Возврат   РезультатЗапроса

КонецФункции //  ПолучитьКИВнешнееСоединение(КодВладельцаДоговора,ВнешнееСоединение)()

