Функция СегодняВыходной()
	
	ДатаОпределения = НачалоДня(ТекущаяДата());
	
	НачальныеДаты = Новый Массив;
	НачальныеДаты.Добавить(ДатаОпределения);
	ПР_К = Справочники.ПроизводственныеКалендари.НайтиПоКоду("РФ");
	
	ДатыБлижайшихРабочихДней = КалендарныеГрафики.ДатыБлижайшихРабочихДней(ПР_К, НачальныеДаты, Истина);
	
	ПредыдущийРабочийДень = ДатыБлижайшихРабочихДней.Получить(ДатаОпределения);
	
	Возврат НЕ ПредыдущийРабочийДень = ДатаОпределения;
	
КонецФункции

Функция РегламентноеЗаданиеВыполнялосьСегодня(ИмяРегламентногоЗадания)
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыполнениеРегламентныхЗаданийСрезПоследних.ДатаЗавершения
		|ИЗ
		|	РегистрСведений.ВыполнениеРегламентныхЗаданий.СрезПоследних(, РегламентноеЗадание = &ИмяРегламентногоЗадания) КАК ВыполнениеРегламентныхЗаданийСрезПоследних";
	
	Запрос.УстановитьПараметр("ИмяРегламентногоЗадания", ИмяРегламентногоЗадания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И ТипЗнч(Выборка.ДатаЗавершения) = Тип("Дата") Тогда
		
		Результат = НачалоДня(Выборка.ДатаЗавершения) = НачалоДня(ТекущаяДата());
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

