Функция ДатаВремяВUnix(ДатаВремя)
	ДатаUTC = УниверсальноеВремя(ДатаВремя);
	ДатаНачалаUnix = '19700101000000';  
	Возврат (ДатаUTC - ДатаНачалаUnix) * 1000;
КонецФункции

Процедура ОповеститьExpress(ТекстОповещения)   
	Если ПустаяСтрока(ТекстОповещения) Тогда
		Возврат;
	КонецЕсли;
	КлючОповещения = "МониторингЗУП";
	Попытка
		НастройкиОповещения = RSN_eXpress.НастройкиОповещенияExpress(КлючОповещения);
	Исключение
		ЗаписьЖурналаРегистрации(
			"Express.Notification",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка получения настроек eXpress: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Соединение = Новый HTTPСоединение(НастройкиОповещения.BaseURL, , , , , НастройкиОповещения.Timeout, Новый ЗащищенноеСоединениеOpenSSL());
	Попытка
		ТокенДоступа = RSN_eXpress.ТокенБота(Соединение, НастройкиОповещения);
		RSN_eXpress.ОтправитьСообщениеВExpress(Соединение, ТокенДоступа, НастройкиОповещения.IdЧата, ТекстОповещения, , НастройкиОповещения.BotID);
	Исключение
		ЗаписьЖурналаРегистрации(
			"Express.Notification",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка отправки сообщения в eXpress: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
КонецПроцедуры

#Область OfferSalary_УведомлениеОПовышенииЗПИзОффера

Процедура OfferSalary_УведомлениеОПовышенииЗПИзОффера()
	СобытиеЖР = "ХД.OfferSalary_УведомлениеОПовышенииЗПИзОффера";
	ЗаписьЖР(СобытиеЖР, "Начало обработки");
	СтрокаРегламентноеЗадание = "OfferSalary_УведомлениеОПовышенииЗПИзОффера";
	сРез = OfferSalary_ИнициализироватьТаблицуРезультата();
	OfferSalary_ЗаполнитьСотрудниковДляУведомления(СобытиеЖР, сРез);
	OfferSalary_СозданиеЭлектронногоПисьмаИсходящего(СобытиеЖР, сРез);
	ЗаписьЖР(СобытиеЖР, "Окончание обработки");
КонецПроцедуры

Функция OfferSalary_ИнициализироватьТаблицуРезультата()
	сРез = Новый ТаблицаЗначений;
	КвалификаторДаты = Новый КвалификаторыДаты(ЧастиДаты.Дата);
	КвалификаторСтроки = Новый КвалификаторыСтроки(300, ДопустимаяДлина.Переменная);
	КвалификаторСуммы = Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный);
	КвалификаторИспСрока = Новый КвалификаторыЧисла(2, 0, ДопустимыйЗнак.Неотрицательный);
	сРез.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	сРез.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	сРез.Колонки.Добавить("СотрудникПредставление", Новый ОписаниеТипов("Строка",,,, КвалификаторСтроки));
	сРез.Колонки.Добавить("ДатаПриема", Новый ОписаниеТипов("Дата",,,,, КвалификаторДаты));
	сРез.Колонки.Добавить("ДатаУведомления", Новый ОписаниеТипов("Дата",,,,, КвалификаторДаты));
	сРез.Колонки.Добавить("ИспСрок", Новый ОписаниеТипов("Число",,, КвалификаторИспСрока));
	сРез.Колонки.Добавить("ДатаОкончанияИспытательногоСрока", Новый ОписаниеТипов("Дата",,,,, КвалификаторДаты));
	сРез.Колонки.Добавить("АктуальнаяСтрока", Новый ОписаниеТипов("Строка",,,, КвалификаторСтроки));
	сРез.Колонки.Добавить("ЗарплатаПослеИспСрока", Новый ОписаниеТипов("Число",,, КвалификаторСуммы));
	сРез.Колонки.Добавить("ЗарплатаЧерез6Мес", Новый ОписаниеТипов("Число",,, КвалификаторСуммы));
	сРез.Колонки.Добавить("ЗарплатаЧерез9Мес", Новый ОписаниеТипов("Число",,, КвалификаторСуммы));
	сРез.Колонки.Добавить("ЗарплатаЧерезГод", Новый ОписаниеТипов("Число",,, КвалификаторСуммы));
	Возврат сРез;
КонецФункции

Процедура OfferSalary_ЗаполнитьСотрудниковДляУведомления(Знач СобытиеЖР, сРез)
	ПараметрыПолучения = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолучения.ОкончаниеПериода = ТекущаяДатаСеанса();
	ПараметрыПолучения.КадровыеДанные = "Организация,ФИОПолные,ДатаПриема,ИспытательныйСрокДатаЗавершения,ДатаУвольнения";
	ТаблицаСотрудников = КадровыйУчет.СотрудникиОрганизации(Ложь, ПараметрыПолучения); 
	НапоминатьЗа = RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("Probation_НапомнитьОПовышенииЗарплатыИзОффера"); 
	ПроверяемаяДата = НачалоДня(ТекущаяДатаСеанса()) + (НапоминатьЗа * 86400); 
	ЗаписьЖР(СобытиеЖР, СтрШаблон("Проверяемая дата: %1", Формат(ПроверяемаяДата, "ДФ=dd.MM.yyyy")));
	Для каждого ДанныеСотрудника Из ТаблицаСотрудников Цикл
		Если ЗначениеЗаполнено(ДанныеСотрудника.ДатаУвольнения) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДанныеСотрудника.ДатаПриема) Тогда
			Продолжить;
		КонецЕсли;
		Сотрудник = ДанныеСотрудника.Сотрудник;
		Если ЗначениеЗаполнено(Сотрудник.ЗарплатаПослеИспСрока)
			И ЗначениеЗаполнено(ДанныеСотрудника.ИспытательныйСрокДатаЗавершения)
			И НачалоДня(ДанныеСотрудника.ИспытательныйСрокДатаЗавершения) = ПроверяемаяДата Тогда
			OfferSalary_ДобавитьСтрокуРезультата(сРез, ДанныеСотрудника, "Salary after probation", ДанныеСотрудника.ИспытательныйСрокДатаЗавершения);
		КонецЕсли;
		Если ЗначениеЗаполнено(Сотрудник.ЗарплатаЧерез6Мес) И НачалоДня(ДобавитьМесяц(ДанныеСотрудника.ДатаПриема, 6)) = ПроверяемаяДата Тогда
			OfferSalary_ДобавитьСтрокуРезультата(сРез, ДанныеСотрудника, "Salary after 6 months", ДобавитьМесяц(ДанныеСотрудника.ДатаПриема, 6));
		КонецЕсли;
		Если ЗначениеЗаполнено(Сотрудник.ЗарплатаЧерез9Мес) И НачалоДня(ДобавитьМесяц(ДанныеСотрудника.ДатаПриема, 9)) = ПроверяемаяДата Тогда
			OfferSalary_ДобавитьСтрокуРезультата(сРез, ДанныеСотрудника, "Salary after 9 months", ДобавитьМесяц(ДанныеСотрудника.ДатаПриема, 9));
		КонецЕсли;
		Если ЗначениеЗаполнено(Сотрудник.ЗарплатаЧерезГод) И НачалоДня(ДобавитьМесяц(ДанныеСотрудника.ДатаПриема, 12)) = ПроверяемаяДата Тогда
			OfferSalary_ДобавитьСтрокуРезультата(сРез, ДанныеСотрудника, "Salary after 1 year", ДобавитьМесяц(ДанныеСотрудника.ДатаПриема, 12));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура OfferSalary_ДобавитьСтрокуРезультата(сРез, Знач ДанныеСотрудника, Знач АктуальнаяСтрока, Знач ДатаУведомления)
	Сотрудник = ДанныеСотрудника.Сотрудник;
	СтрокаРезультата = сРез.Добавить();
	СтрокаРезультата.Организация = ДанныеСотрудника.Организация;
	СтрокаРезультата.Сотрудник = Сотрудник;
	СтрокаРезультата.СотрудникПредставление = ДанныеСотрудника.ФИОПолные;
	СтрокаРезультата.ДатаПриема = ДанныеСотрудника.ДатаПриема;
	СтрокаРезультата.ДатаУведомления = ДатаУведомления;
	Если ЗначениеЗаполнено(ДанныеСотрудника.ИспытательныйСрокДатаЗавершения) Тогда
		СтрокаРезультата.ИспСрок = РазницаДатВМесяцах(ДанныеСотрудника.ДатаПриема, ДанныеСотрудника.ИспытательныйСрокДатаЗавершения);
		СтрокаРезультата.ДатаОкончанияИспытательногоСрока = ДанныеСотрудника.ИспытательныйСрокДатаЗавершения;
	КонецЕсли;
	СтрокаРезультата.АктуальнаяСтрока = АктуальнаяСтрока;
	СтрокаРезультата.ЗарплатаПослеИспСрока = Сотрудник.ЗарплатаПослеИспСрока;
	СтрокаРезультата.ЗарплатаЧерез6Мес = Сотрудник.ЗарплатаЧерез6Мес;
	СтрокаРезультата.ЗарплатаЧерез9Мес = Сотрудник.ЗарплатаЧерез9Мес;
	СтрокаРезультата.ЗарплатаЧерезГод = Сотрудник.ЗарплатаЧерезГод;
КонецПроцедуры

Функция OfferSalary_ТекстПисьма(Знач СобытиеЖР, сРез)
	Макет = ПолучитьМакет("ХД_ПовышениеЗПИзОффера_HTML");
	ТекстHTML = Макет.ПолучитьТекст();
	ТекстHTML = СтрЗаменить(ТекстHTML, "{Описание}", "Salary increases from offer for the following employees:");
	ТекстHTML = OfferSalary_ЗаполнитьКарточкиПисьма(ТекстHTML, сРез);
	Возврат ТекстHTML;
КонецФункции

Функция OfferSalary_ЗаполнитьКарточкиПисьма(Знач ТекстHTML, Знач сРез)
	ШаблонКарточки = OfferSalary_ШаблонКарточкиHTML(ТекстHTML);
	Если ПустаяСтрока(ШаблонКарточки) Тогда
		Возврат ТекстHTML;
	КонецЕсли;
	ТекстКарточек = "";
	Для каждого СтрокаРезультата Из сРез Цикл
		ТекстКарточек = ТекстКарточек + ?(ПустаяСтрока(ТекстКарточек), "", "<br/>") + OfferSalary_КарточкаПисьма(ШаблонКарточки, СтрокаРезультата);
	КонецЦикла;
	Возврат СтрЗаменить(ТекстHTML, ШаблонКарточки, ТекстКарточек);
КонецФункции

Функция OfferSalary_ШаблонКарточкиHTML(Знач ТекстHTML)
	НачалоКарточки = СтрНайти(ТекстHTML, "<table border=""1"" cellpadding=""10px"">");
	Если НачалоКарточки = 0 Тогда
		Возврат "";
	КонецЕсли;
	ТекстПослеНачала = Сред(ТекстHTML, НачалоКарточки);
	КонецКарточки = СтрНайти(ТекстПослеНачала, "</table>");
	Если КонецКарточки = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(ТекстПослеНачала, 1, КонецКарточки + СтрДлина("</table>") - 1);
КонецФункции

Функция OfferSalary_КарточкаПисьма(Знач ШаблонКарточки, Знач СтрокаРезультата)
	КарточкаHTML = ШаблонКарточки;
	КарточкаHTML = СтрЗаменить(КарточкаHTML, "{Сотрудник}", УведомленияИзОффераЗначениеHTML(СтрокаРезультата.СотрудникПредставление));
	КарточкаHTML = СтрЗаменить(КарточкаHTML, "{ДатаПриема}", УведомленияИзОффераДатаHTML(СтрокаРезультата.ДатаПриема));
	КарточкаHTML = СтрЗаменить(КарточкаHTML, "{ИспСрок}", УведомленияИзОффераЗначениеHTML(СтрокаРезультата.ИспСрок));
	КарточкаHTML = СтрЗаменить(КарточкаHTML, "{ДатаОкончанияИспытательногоСрока}", УведомленияИзОффераДатаHTML(СтрокаРезультата.ДатаОкончанияИспытательногоСрока));
	КарточкаHTML = СтрЗаменить(КарточкаHTML, "{Организация}", УведомленияИзОффераЗначениеHTML(СтрокаРезультата.Организация));
	КарточкаHTML = OfferSalary_ЗаполнитьСтрокуЗарплаты(КарточкаHTML, СтрокаРезультата, "Salary after probation", "Зарплата после испытательного срока:", "{ЗарплатаПослеИспСрока}", СтрокаРезультата.ЗарплатаПослеИспСрока);
	КарточкаHTML = OfferSalary_ЗаполнитьСтрокуЗарплаты(КарточкаHTML, СтрокаРезультата, "Salary after 6 months", "Зарплата через 6 мес:", "{ЗарплатаЧерез6Мес}", СтрокаРезультата.ЗарплатаЧерез6Мес);
	КарточкаHTML = OfferSalary_ЗаполнитьСтрокуЗарплаты(КарточкаHTML, СтрокаРезультата, "Salary after 9 months", "Зарплата через 9 мес:", "{ЗарплатаЧерез9Мес}", СтрокаРезультата.ЗарплатаЧерез9Мес);
	Возврат OfferSalary_ЗаполнитьСтрокуЗарплаты(КарточкаHTML, СтрокаРезультата, "Salary after 1 year", "Зарплата через год:", "{ЗарплатаЧерезГод}", СтрокаРезультата.ЗарплатаЧерезГод);
КонецФункции

Функция OfferSalary_ЗаполнитьСтрокуЗарплаты(Знач КарточкаHTML, Знач СтрокаРезультата, Знач АктуальнаяСтрока, Знач НаименованиеСтроки, Знач ПараметрСуммы, Знач Сумма)
	НаименованиеHTML = УведомленияИзОффераЗначениеHTML(НаименованиеСтроки);
	СуммаHTML = УведомленияИзОффераЗначениеHTML(Сумма);
	Если СтрокаРезультата.АктуальнаяСтрока = АктуальнаяСтрока Тогда
		НаименованиеHTML = СтрШаблон("<b>%1</b>", НаименованиеHTML);
		СуммаHTML = СтрШаблон("<b>%1</b>", СуммаHTML);
	КонецЕсли;
	КарточкаHTML = СтрЗаменить(КарточкаHTML, НаименованиеСтроки, НаименованиеHTML);
	Возврат СтрЗаменить(КарточкаHTML, ПараметрСуммы, СуммаHTML);
КонецФункции

Процедура OfferSalary_СозданиеЭлектронногоПисьмаИсходящего(Знач СобытиеЖР, сРез)
	Если сРез.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("Системная учетная запись");
	ПолучателиПисьма = RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("OfferSalary_Рассылка_УведомлениеОПовышенииЗПИзОффера", Истина);
	ТекстHTML = OfferSalary_ТекстПисьма(СобытиеЖР, сРез);
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Тема", "ZUP: Salary increase from offer notification");
	ПараметрыПисьма.Вставить("ТипТекста", Перечисления.ТипыТекстовЭлектронныхПисем.HTML);
	ПараметрыПисьма.Вставить("Текст", ТекстHTML);
	ПараметрыПисьма.Вставить("ТекстHTML", ТекстHTML);
	ПараметрыПисьма.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ПараметрыПисьма.Вставить("ПолучателиПисьма", ПолучателиПисьма);
	УправлениеЭлектроннойПочтой.СоздатьИсходящееПисьмо(ПараметрыПисьма);
КонецПроцедуры

#КонецОбласти

#Область OfferPerformanceBonus_УведомлениеОБонусеИзОффера

Процедура OfferPerformanceBonus_УведомлениеОБонусеИзОффера()
	СобытиеЖР = "ХД.OfferPerformanceBonus_УведомлениеОБонусеИзОффера";
	ЗаписьЖР(СобытиеЖР, "Начало обработки");
	сРез = OfferPerformanceBonus_СотрудникиДляУведомления(СобытиеЖР);
	OfferPerformanceBonus_СозданиеЭлектронногоПисьмаИсходящего(СобытиеЖР, сРез);
	ЗаписьЖР(СобытиеЖР, "Окончание обработки");
КонецПроцедуры

Функция OfferPerformanceBonus_СотрудникиДляУведомления(Знач СобытиеЖР)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ТекущаяДатаСеанса()));
	Запрос.Текст = "ВЫБРАТЬ
	|	ТекущиеКадровыеДанныеСотрудников.Сотрудник КАК Сотрудник,
	|	ТекущиеКадровыеДанныеСотрудников.Сотрудник.Наименование КАК СотрудникПредставление,
	|	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация КАК Организация,
	|	ТекущиеКадровыеДанныеСотрудников.ДатаПриема КАК ДатаПриема,
	|	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_PerformanceBonusPerOffer КАК PerformanceBonus,
	|	ZUPC_PerformanceBonusNotificationDates.NotificationDate КАК NotificationDate
	|ИЗ
	|	Справочник.Сотрудники.ZUPC_PerformanceBonusNotificationDates КАК ZUPC_PerformanceBonusNotificationDates
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	|		ПО ZUPC_PerformanceBonusNotificationDates.Ссылка = ТекущиеКадровыеДанныеСотрудников.Сотрудник
	|ГДЕ
	|	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И ВЫРАЗИТЬ(ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_PerformanceBonusPerOffer КАК СТРОКА(1024)) <> """"
	|	И ZUPC_PerformanceBonusNotificationDates.NotificationDate МЕЖДУ &НачалоДня И &КонецДня";
	сРез = Запрос.Выполнить().Выгрузить();
