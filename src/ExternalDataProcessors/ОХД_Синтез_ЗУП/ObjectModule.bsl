Функция МассивВТаблицуЗначений(МассивСоответствий, мРез) Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	
	Если ТипЗнч(МассивСоответствий) = Тип("Массив")
		И МассивСоответствий.Количество() <> 0 Тогда
		
		
		Для каждого МСоответствие Из МассивСоответствий  Цикл
			
			МассивВТаблицуЗначений(МСоответствие,мРез);
			
		КонецЦикла; 
		
	ИначеЕсли  ТипЗнч(МассивСоответствий) = Тип("Соответствие") Тогда 
		
		СтрСтруктура = Новый Структура;
		
		мСтр = Новый Массив; 
		Для каждого МСоответствие  Из МассивСоответствий Цикл
			
			Если ТипЗнч(МСоответствие.Значение) = Тип("Соответствие") 
				или ТипЗнч(МСоответствие.Значение) = Тип("Массив") Тогда
				
				мСтрЭтаж = Новый Массив; 
				
				МассивВТаблицуЗначений(МСоответствие.Значение, мСтрЭтаж);
				СтрСтруктура.Вставить(МСоответствие.Ключ, мСтрЭтаж);
				
			Иначе
				
				Если ТипЗнч(МСоответствие.Ключ) = Тип("Строка")Тогда
					
					КлючДопустимый = МСоответствие.Ключ;
					КлючДопустимый = СтрЗаменить(КлючДопустимый,"-","_");
				
				КонецЕсли; 
				
				СтрСтруктура.Вставить(КлючДопустимый, МСоответствие.Значение);
				
			КонецЕсли;
		
		КонецЦикла;	
		
		мСтр.Добавить(СтрСтруктура); 
		мРез.Добавить(мСтр);
		
	Иначе

		//Для Каждого МСоответствие Из МассивСоответствий Цикл
		//	СтрСтруктура = Новый Структура;
		//	Если ТипЗнч(МСоответствие) = Тип("Соответствие") Тогда
		//		Для каждого Соотв Из МСоответствие Цикл
		//			СтрСтруктура.Вставить(МСоответствие.Ключ,МСоответствие.Значение);
		//		КонецЦикла;
		//	КонецЕсли;
		//	
		//КонецЦикла;
		

	КонецЕсли; 
	
	
	Возврат Таблица;
КонецФункции

