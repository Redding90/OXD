Функция ПолучитьКонтрагентаВнешнееСоединение(ФИО,ВнешнееСоединение)
	
	мФИО =  СинтезСтрокиПробел(ФИО);
	
	Запрос = ВнешнееСоединение.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	Договоры.Ссылка КАК Ссылка,
	|	Договоры.Владелец КАК Владелец,
	|	ТИПЗНАЧЕНИЯ(Договоры.Владелец) КАК Тип,
