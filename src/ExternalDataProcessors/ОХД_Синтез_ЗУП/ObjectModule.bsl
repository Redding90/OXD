Функция АдаптироватьТелефон(Тел, НекоррТелМассив)

	Тел = СтрЗаменить(Тел,"-",""); 
	Тел = СтрЗаменить(Тел,"(","");
	Тел = СтрЗаменить(Тел,")","");
	Тел = СтрЗаменить(Тел," ","");
	Если Лев(Тел,1)<>"+"  Тогда
		с_кол = СтрДлина(Тел);   
		Тел = Прав(Тел, с_кол-1);
		Тел = "+7" + Тел;
	КонецЕсли;
	//+79257711158 -  12 символов   
	с_кол = СтрДлина(Тел);
	Если с_кол>12  Тогда
		ПозТел = СтрНайти(Тел,"+"); 
		Тел = Сред(Тел,ПозТел,12);  
	ИначеЕсли  с_кол<12 Тогда  
		НеправильныйНомер = Истина;
		НекоррТелМассив.Добавить(Тел); 
		Возврат Неопределено;
	КонецЕсли;
		
	Возврат Тел;
КонецФункции // АдаптироватьТелефон(эл.МобильныйТелефон)()


