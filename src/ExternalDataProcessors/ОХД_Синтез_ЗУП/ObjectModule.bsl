Функция Probation_ИнициализироватьТаблицуРезультата()
	
	сРез = Новый ТаблицаЗначений;
	
	КавлификаторДаты = Новый КвалификаторыДаты(ЧастиДаты.Дата);
	КавлификаторСтроки = Новый КвалификаторыСтроки(300,ДопустимаяДлина.Переменная);
	КвалификаторЧисла = Новый КвалификаторыЧисла(3,0,ДопустимыйЗнак.Неотрицательный);
	
	сРез.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	сРез.Колонки.Добавить("Сотрудник",   Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	сРез.Колонки.Добавить("ДатаПриема",  Новый ОписаниеТипов("Дата",,,,,КавлификаторДаты));
	сРез.Колонки.Добавить("ИспСрок",     Новый ОписаниеТипов("Число",,,КвалификаторЧисла),"Исп.срок");
	сРез.Колонки.Добавить("ДатаОкончанияИспытытельногоСрока", Новый ОписаниеТипов("Дата",,,,,КавлификаторДаты));
	сРез.Колонки.Добавить("ФИОПолные",   Новый ОписаниеТипов("Строка",,,,КавлификаторСтроки));
	
	Возврат сРез;
	
КонецФункции

Процедура Probation_СотрудникиСЗаканчивающимсяИспытательнымСроком(СобытиеЖР, сРез)
	
	ПараметрыПолучения = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолучения.ОкончаниеПериода = ТекущаяДатаСеанса();
	ПараметрыПолучения.КадровыеДанные = "Организация,ФИОПолные,ДатаПриема,ИспытательныйСрокДатаЗавершения,ДатаУвольнения";    
	
	ТаблицаСотрудников = КадровыйУчет.СотрудникиОрганизации(Ложь, ПараметрыПолучения);
	
	НапоминатьЗа = RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("Probation_НапомнитьОбОкончанииИспСрока"); 
	
	ПроверяемаяДата = ТекущаяДатаСеанса() + (НапоминатьЗа * 86400);  
	
	ЗаписьЖР(СобытиеЖР, "Проверяемая дата:" + ПроверяемаяДата);
		
	Для каждого ДанныеСотрудника Из ТаблицаСотрудников Цикл 
		Если ЗначениеЗаполнено(ДанныеСотрудника.ДатаУвольнения) Тогда
			Продолжить;	
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСотрудника.ИспытательныйСрокДатаЗавершения) И 
			НачалоДня(ПроверяемаяДата) = НачалоДня(ДанныеСотрудника.ИспытательныйСрокДатаЗавершения) Тогда

			СтрокаРезультата = сРез.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРезультата,ДанныеСотрудника);
			СтрокаРезультата.ДатаОкончанияИспытытельногоСрока = ДанныеСотрудника.ИспытательныйСрокДатаЗавершения;
			
			ИспСрок = РазницаДатВМесяцах(ДанныеСотрудника.ДатаПриема, ДанныеСотрудника.ИспытательныйСрокДатаЗавершения);
			
			СтрокаРезультата.ИспСрок = ИспСрок; 
			
		КонецЕсли;
		
	КонецЦикла; 
		
КонецПроцедуры

Функция Probation_ТекстПисьма(СобытиеЖР, сРез) 
	
	ЧастиТекста = Новый Массив;
	//
	НапоминатьЗа = RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("BirthDay_НапомнитьОДняхРожденияхСотрудников");
	//
	ДатаДняРождения = Формат(ТекущаяДатаСеанса() + (НапоминатьЗа * 86400), "ДФ=dd.MM.yyyy");
	//
	СклонениеДня = СтроковыеФункцииКлиентСервер.ФормаМножественногоЧисла("день","дня","дней", НапоминатьЗа);
	//
	ЧастьТекста = СтрШаблон("Через %1 %2 (%3) у следующих сотрудников заканчивается испытательный срок:",НапоминатьЗа,СклонениеДня,Формат(ДатаДняРождения, "ДФ=dd.MM.yyyy"));
		
	Макет = ПолучитьМакет("ХД_ИспытательныйСрок_HTML");	
	
	ТекстHTML = Макет.ПолучитьТекст();        
	
	ТекстHTML = СтрЗаменить(ТекстHTML, "{<b>Описание</b>}",ЧастьТекста); 
	
	СтрокаКолонок = "Сотрудник,ДатаПриема,ИспСрок,ДатаОкончанияИспытытельногоСрока,Организация";
	
	мМассив  = СтрРазделить(СтрокаКолонок,",");
	
