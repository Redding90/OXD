Процедура ОтправитьHRИзменениеЗПНДФЛ()

	СобытиеЖР = "ХД.ОтправитьHRИзменениеЗПНДФЛ";
	
	ЗаписьЖР(СобытиеЖР, "Начало обработки");
	
	СтрокаРегламентноеЗадание = "ОтправитьHRИзменениеЗПНДФЛ";
	
	Если НЕ РегламентноеЗадание_ВсеУсловияВыполнены(СобытиеЖР, СтрокаРегламентноеЗадание) Тогда
		ЗаписьЖР(СобытиеЖР, "Не все условия проверки выполнены!");
		ЗаписьЖР(СобытиеЖР, "Окончание обработки");
		Возврат;
	КонецЕсли; 
	
	СписокФизЛицОрганизация = ПолучитьСписокСотрудников(СобытиеЖР);
	
	сРез = ВыполнитьHRИзменениеЗП(СобытиеЖР, СписокФизЛицОрганизация); 

	дФайла = ЗаписьВФайлИзменениеНДФЛ(СобытиеЖР, сРез);
	
	HRИзменениеЗП_СозданиеЭлектронногоПисьмаИсходящего(СобытиеЖР, сРез, дФайла);

	ЗаписьЖР(СобытиеЖР, "Окончание обработки");
	
КонецПроцедуры

Функция ВыполнитьHRИзменениеЗП(СобытиеЖР, СписокФизЛицОрганизация)
   	
	ЗаписьЖР(СобытиеЖР, "Начало сбора данных по зарплате");

	//Период = ЗарплатаКадрыОтчеты.НайтиПараметр(КомпоновщикНастроек, "Период").Значение; 
	ДатаНачала = НачалоГода(ТекущаяДата());
	ДатаОкончания = ТекущаяДата();
	
	ДатаНачалаНП = ДатаНачала;
	ДатаКонцаНП  =  ДатаОкончания;
	//ДатаПодписи  = ЗарплатаКадрыОтчеты.НайтиПараметр(КомпоновщикНастроек, "ДатаПодписи").Значение;
	//Если ТипЗнч(ДатаПодписи) = Тип("СтандартнаяДатаНачала") Тогда 
	//	ДатаПодписи = ДатаПодписи.Дата;
	//КонецЕсли;	
	
	//Если ДатаПодписи = Неопределено Или ДатаПодписи = '00010101' Тогда
		ДатаПодписи = ТекущаяДатаСеанса();
	//КонецЕсли;
	Ответственный = Неопределено;

	ФизическоеЛицоОтветственного = ?(Ответственный = Неопределено, Справочники.ФизическиеЛица.ПустаяСсылка(), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ответственный.Значение, "ФизическоеЛицо"));
	
	// Создание запроса и установка всех необходимых параметров.
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ответственный", Ответственный);
