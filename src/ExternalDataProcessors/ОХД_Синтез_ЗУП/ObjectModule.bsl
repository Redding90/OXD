Процедура Zoho_УведомлениеОНовомСотруднике()
	
	СобытиеЖР = "ХД.Zoho_УведомлениеОНовомСотруднике";
	
	ЗаписьЖР(СобытиеЖР, "Начало обработки");
	
	сРез = Новый ТаблицаЗначений; 
	
	СтрокаРегламентноеЗадание = "Zoho_УведомлениеОНовомСотруднике";
	Если НЕ РегламентноеЗадание_ВсеУсловияВыполнены(СобытиеЖР, СтрокаРегламентноеЗадание) Тогда
		ЗаписьЖР(СобытиеЖР, "Не все условия проверки выполнены!");
		ЗаписьЖР(СобытиеЖР, "Окончание обработки");
		Возврат;
	КонецЕсли;
	
	//КаталогФайлаКИ = ОбщегоНазначенияВызовСервера.ЗначениеДополнительнойКонстанты("КаталогФайлаЗагрузкиБазыКлиентов- selecom.pro");
	
	Zoho_ПроверкаНеОтправленных_Выполнение(СобытиеЖР, сРез);
	
	Zoho_СозданиеЭлектронногоПисьмаИсходящего(СобытиеЖР, сРез);
	
	ЗаписатьЗавершениеУведомления(СобытиеЖР, сРез);
	
	//ЗаписатьЗавершениеЗаданияВРегистр("Zoho_УведомлениеОНовомСотруднике");
	
	ЗаписьЖР(СобытиеЖР, "Окончание обработки");
	
	
КонецПроцедуры  

Процедура ЗаписатьЗавершениеУведомления(СобытиеЖР, сРез)
	
	Для каждого эл Из сРез Цикл
		
		ВыпРас = РегистрыСведений.ВыполнениеРассылки.СоздатьМенеджерЗаписи();
		ВыпРас.Объект = эл.Сотрудник;
		ВыпРас.Прочитать();
		
		Если ЗначениеЗаполнено(ВыпРас.Объект) Тогда
			ВыпРас.Выполнено = Истина;
			Попытка
				ВыпРас.Записать();
			Исключение
				ЗаписьЖР(СобытиеЖР, "Не удалось записать выполнение рассылки", , Истина, ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Zoho_ПроверкаНеОтправленных_Выполнение(СобытиеЖР, сРез)
	
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.Офис КАК Офис,
	|	Сотрудники.НомерМеста КАК НомерМеста,
	|	Сотрудники.ГоловнаяОрганизация.Представление КАК Организация,
	|	Сотрудники.СоздатьАккаунт КАК СоздатьАккаунт,
	|	Сотрудники.ОрганизоватьРабочееМесто КАК ОрганизоватьРабочееМесто,
	|	Сотрудники.Пропуск КАК Пропуск,
	|	Сотрудники.МобильныйТелефон КАК МобильныйТелефон
	|ИЗ
