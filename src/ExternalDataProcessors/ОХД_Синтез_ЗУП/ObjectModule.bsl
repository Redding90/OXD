	Если НеРегистрироватьВыполнениеРассылки Тогда
		Возврат;
	КонецЕсли;
	
	Если УдалитьПредыдущие Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыполнениеРегламентныхЗаданий.Рассылка
		|ИЗ
		|	РегистрСведений.ВыполненныеРассылки КАК ВыполненныеРассылки
		|ГДЕ
		|	ВыполненныеРассылки.Рассылка = &Рассылка";
		
		Запрос.УстановитьПараметр("Рассылка", Рассылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.ВыполнениеРегламентныхЗаданий.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Рассылка.Установить(ВыборкаДетальныеЗаписи.Рассылка);
