Функция ВыполнитьHttpIdSd(token_work, НачальныйИндекс, РазмерСтраницы, Рез)
	Путь           = "sd.phoenixtrading.ltd";
	
	Файл           = КаталогВременныхФайлов()+"sd.txt";
	
	//ПоляПоиска = Новый Структура;   
	//ПоляПоиска.Вставить("email_id", эл.Почта);//"rinat.galimov@phoenixtrading.ltd");
	
	мДет  = Новый Структура;
	мДет.Вставить("row_count", РазмерСтраницы);
	мДет.Вставить("start_index", НачальныйИндекс);
	//мДет.Вставить("search_fields",ПоляПоиска);
	
	сЛистИнфо = Новый Структура;  	
	сЛистИнфо.Вставить("list_info",мДет); 
	
	ДанныеЗапроса  = новый СТруктура; 
	ДанныеЗапроса.Вставить("input_data",сЛистИнфо);  
	
	input_data = JSON(сЛистИнфо);
	Запрос= "/api/v3/users?input_data=" + input_data;
	
	//https://sd.phoenixtrading.ltd/api/v3/users?input_data={"list_info":{"row_count":"25"}}}
	
	Попытка 
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8"); 
		Заголовки.Вставить("Authtoken", token_work);
		//Заголовки.Вставить("HTTP_X_HTTP_METHOD_OVERRIDE","GET");
		
		ЗапросМ = Новый HTTPЗапрос(Запрос,Заголовки);
		HTTPСоединение = Новый HTTPСоединение(
			Путь, , , , , 60, Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено));
		Ответ = HTTPСоединение.Получить(ЗапросМ,Файл);              
		//Рез = Ответ.ПолучитьТелоКакСтроку();   
		
		Если Ответ.КодСостояния <> 200 Тогда
			ТекстСообщения = "Не удалось выполнить запрос веб-сервиса. Код ответа: " + Ответ.КодСостояния;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить();
			Возврат Ложь;
		КонецЕсли;
		
		ЧтениеJSON     = Новый ЧтениеJSON;
		ЧтениеJSON.ОткрытьФайл(Файл);
		МассивДанных   = ПрочитатьJSON(ЧтениеJSON,Истина);
		ЧтениеJSON.Закрыть();
		
		Если Не ОбработатьПакет(МассивДанных, Рез) Тогда
			Сообщить("Данные кончились на шаге: " + НачальныйИндекс);
			Возврат Ложь;
		КонецЕсли;
		
		ЕстьСледующаяСтраница = ЕстьСледующаяСтраницаSD(МассивДанных);
		Если ЕстьСледующаяСтраница <> Неопределено Тогда
			Возврат ЕстьСледующаяСтраница;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	Возврат Ложь;
КонецФункции 

Функция ЕстьСледующаяСтраницаSD(МассивДанных)
	ЛистИнфо = МассивДанных.Получить("list_info");
	Если ЛистИнфо = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Признак = ЛистИнфо.Получить("has_more_rows");
	Если Признак = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Признак) = Тип("Булево") Тогда
		Возврат Признак;
	КонецЕсли;
	ПризнакСтрокой = НРег(Строка(Признак));
	Если ПризнакСтрокой = "true" Или ПризнакСтрокой = "истина" Или ПризнакСтрокой = "1" Тогда
		Возврат Истина;
	КонецЕсли;
	Если ПризнакСтрокой = "false" Или ПризнакСтрокой = "ложь" Или ПризнакСтрокой = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ОбновитьИДВРегистре(Рез)
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
