Функция unJSON(Файл) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON; 
	
	Если  ТипЗнч(Файл) = Тип("Строка") Тогда
		ЧтениеJSON.УстановитьСтроку(Файл);    
	Иначе 
		ЧтениеJSON.ОткрытьФайл(Файл);
	КонецЕсли;
		
	Результат = ПрочитатьJSON(ЧтениеJSON,Истина);
	ЧтениеJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

