Процедура ЗаписатьЗавершениеЗаданияВРегистр(ИмяРегламентногоЗадания, УдалитьПредыдущие = Истина)
	
	Если НеРегистрироватьВыполнениеЗаданияВРегистрВыполненных Тогда
		Возврат;
	КонецЕсли;
	
	Если УдалитьПредыдущие Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВыполнениеРегламентныхЗаданий.Период,
			|	ВыполнениеРегламентныхЗаданий.РегламентноеЗадание
			|ИЗ
			|	РегистрСведений.ВыполнениеРегламентныхЗаданий КАК ВыполнениеРегламентныхЗаданий
			|ГДЕ
			|	ВыполнениеРегламентныхЗаданий.РегламентноеЗадание = &РегламентноеЗадание";
		
		Запрос.УстановитьПараметр("РегламентноеЗадание", ИмяРегламентногоЗадания);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.ВыполнениеРегламентныхЗаданий.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Период.Установить(ВыборкаДетальныеЗаписи.Период);
			НаборЗаписей.Отбор.РегламентноеЗадание.Установить(ВыборкаДетальныеЗаписи.РегламентноеЗадание);
			НаборЗаписей.Записать(Истина);
			
		КонецЦикла;
	
	КонецЕсли;
	
	мз = РегистрыСведений.ВыполнениеРегламентныхЗаданий.СоздатьМенеджерЗаписи();
	мз.Период = ТекущаяДата();
	мз.РегламентноеЗадание = ИмяРегламентногоЗадания;
	мз.ДатаЗавершения = ТекущаяДата();
	
	мз.Записать(Истина);
	
КонецПроцедуры

