	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектП, КИ_JSON, СтруктураКИ.Вид, ТекущаяДата(), Ложь);
	
	//ЗначениеВРеквизитФормы(ОбъектП, "Объект");
	
КонецПроцедуры

Функция EXCELВТаблицуЗначений(ДвоичныеДанные, Расширение,СобытиеЖР)
	
	Попытка 
		ФайлEXCELНаСервере = ПолучитьИмяВременногоФайла(Расширение);
		ДвоичныеДанные.Записать(ФайлEXCELНаСервере);
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Прочитать(ФайлEXCELНаСервере);
	Исключение
		ЗаписьЖР(СобытиеЖР, "Ошибка чтения файла: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	УдалитьФайлы(ФайлEXCELНаСервере);
	
	Результат = Новый СписокЗначений;
	Области = ТабличныйДокумент.Области;
	Если Области.Количество()=0 Тогда 
		ВызватьИсключение("В файле нет областей");
	КонецЕсли;
	
	ФункцияОбработкиСтрок = "СокрЛП(?)";
	
	МассивДанных = Новый Массив;

	Для Каждого Обл Из Области Цикл
		ТекТабДок = Новый ТабличныйДокумент;   
		ТД = Новый Структура;
		ОгрОбласть = ПолучитьОграниченнуюОбласть(ТабличныйДокумент, Обл);
		// вставим область в табдок
		ОгрОбласть.Имя = Обл.Имя;
		ТекТабДок.ВставитьОбласть(ОгрОбласть, 
		ТекТабДок.Область(1, ОгрОбласть.Лево, ОгрОбласть.Низ - ОгрОбласть.Верх + 1, ОгрОбласть.Право)
		);
		
		ОбластьТ = ТекТабДок.Область(ОгрОбласть.Верх, ОгрОбласть.Лево, ОгрОбласть.Низ - ОгрОбласть.Верх + 1, ОгрОбласть.Право);  
		
		СократитьСтроки(ТекТабДок, ФункцияОбработкиСтрок);
		
		ТД.Вставить("ОгрОбластьИмя",ОгрОбласть.Имя);
		ТД.Вставить("ТекТабДок",ТекТабДок); 
		ТД.Вставить("ОбластьТ",ОбластьТ);
       
		МассивДанных.Добавить(ТД);
		Результат.Добавить(ТекТабДок, Обл.Имя);
	КонецЦикла;
	
	
	//ОбластьТаблицы = ТабличныйДокумент.Область(1, 1, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы);
	    Рез = Новый Массив;
		Для каждого эл Из МассивДанных Цикл  
			//ОбластьТаблицы = эл.Значение.Область(1, 1,  эл.Значение.ВысотаТаблицы,  эл.Значение.ШиринаТаблицы);
			ОбластьТаблицы = эл.ОбластьТ;
			ПостроительЗапроса = Новый ПостроительЗапроса;
			ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьТаблицы);
			ПостроительЗапроса.Выполнить();
			ТаблицаДанных = ПостроительЗапроса.Результат.Выгрузить();  
			Рез.Добавить(ТаблицаДанных);
		КонецЦикла;
	
	Возврат Рез;
	
КонецФункции       

Функция o_EXCELВТаблицуЗначений(ДвоичныеДанные, Расширение,СобытиеЖР)
	
	Попытка 
		ФайлEXCELНаСервере = ПолучитьИмяВременногоФайла(Расширение);
		ДвоичныеДанные.Записать(ФайлEXCELНаСервере);
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Прочитать(ФайлEXCELНаСервере);
	Исключение
		ЗаписьЖР(СобытиеЖР, "Ошибка чтения файла: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	УдалитьФайлы(ФайлEXCELНаСервере);
	
	ОбластьТаблицы = ТабличныйДокумент.Область(2, 1, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы);
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
