Процедура ЗагрузкаДанныхВНовыхСотрудников_Выполнение(СобытиеЖР, нОстутствуют)

	  		
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	НовыеCотрудники.СотрудникСтрока КАК СотрудникСтрока,
	|	НовыеCотрудники.Сотрудник КАК Сотрудник,
	|	НовыеCотрудники.ДатаВыхода КАК ДатаВыхода,
	|	НовыеCотрудники.Сотрудник.НомерМеста КАК сНомерМеста,
	|	НовыеCотрудники.Сотрудник.Офис КАК сОфис,
	|	НовыеCотрудники.Офис КАК нОфис,
	|	НовыеCотрудники.НомерМеста КАК нНомерМеста
	|ИЗ
	|	РегистрСведений.НовыеCотрудники КАК НовыеCотрудники
	|ГДЕ
	|	НовыеCотрудники.Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	И (НовыеCотрудники.Сотрудник.Офис <> ЗНАЧЕНИЕ(Справочник.Офисы.ПустаяСсылка)
	|	Или НовыеCотрудники.Сотрудник.НомерМеста <> ЗНАЧЕНИЕ(Справочник.НомерМеста.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВыхода";
	
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
