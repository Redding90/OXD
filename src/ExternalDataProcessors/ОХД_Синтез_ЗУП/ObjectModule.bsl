Функция АдаптироватьЧисло(мЧисло)
	Если мЧисло =""  Тогда
		мЧисло = 0;
	Иначе 
		мЧисло = Число(СтрЗаменить(мЧисло,",",""));
	КонецЕсли;
		
	Возврат   мЧисло;
КонецФункции // АдаптироватьЧисло()


