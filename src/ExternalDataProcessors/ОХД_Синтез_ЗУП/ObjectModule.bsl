		мз.ДатаСоздания = ТекущаяДата();
		мз.Рассылка = Рассылка;
		мз.Объект = Получатели.Ссылка;
		мз.ЭлектронноеПисьмоИсходящее = ЭлектронноеПисьмоИсходящее;
		мз.Записать(Истина);	
	
	ЗаписьЖР(СобытиеЖР, "Рассылки выполненны: " + ТекущаяДата());
	
КонецПроцедуры
 
Процедура ЗаписьЖР(СобытиеЖР, Комментарий, ЖурналОбработки = Неопределено, ЕстьОшибки = Ложь, ОписаниеОшибки = Неопределено, ИзменитьНаУровень = Неопределено)
	
	УровеньЖР = УровеньЖурналаРегистрации.Информация;
	
	Если ЕстьОшибки Тогда
		
		УровеньЖР = УровеньЖурналаРегистрации.Ошибка;
		
		Если НЕ ОписаниеОшибки = Неопределено Тогда
			
			ОписаниеОшибки = ОписаниеОшибки + Комментарий + Символы.ПС;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ИзменитьНаУровень = Неопределено Тогда
		УровеньЖР = ИзменитьНаУровень;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(СобытиеЖР,УровеньЖР,,,Комментарий);
	
	Если Не ЖурналОбработки = Неопределено Тогда
		
		ЖурналОбработки = ЖурналОбработки + ТекущаяДатаСеанса() + ": " + Комментарий + Символы.ПС + Символы.ПС;
		
	КонецЕсли;
	
КонецПроцедуры


