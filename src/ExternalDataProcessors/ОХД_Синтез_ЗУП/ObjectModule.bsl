Функция СтрокаИзОбъектаXDTO(ОбъектXDTO)
	
	Результат = "";
	
	Если ТипЗнч(ОбъектXDTO) = Тип("Строка") Тогда
		
		Результат = ОбъектXDTO;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьОбъектXDTO(ВнешняяФабрикаXDTO, ИмяТипа)
	
	ТипОбъектаXDTO = ВнешняяФабрикаXDTO.Тип("http://psbam_exchange/agent_exchange", ИмяТипа);
	
	ОбъектXDTO = ВнешняяФабрикаXDTO.Создать(ТипОбъектаXDTO);
	
	Возврат ОбъектXDTO;
	
КонецФункции

