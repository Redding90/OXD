Функция УведомленияИзОффераЗначениеHTML(Знач Значение)
	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, "<br/>");
	Текст = СтрЗаменить(Текст, Символы.ПС, "<br/>");
	Возврат СтрЗаменить(Текст, Символы.ВК, "<br/>");
КонецФункции     

