Функция ПодготовитьТаблицуHR(мРез, тРез)
	
	ZUPC_ActualDepartmentName ="";
	
	Для каждого эл Из мРез Цикл
		
		Если  ЗначениеЗаполнено(эл.Name_Surname) и  ЗначениеЗаполнено(эл.JobTitle)  Тогда
		   НоваяСтрока =  тРез.Добавить();   
		   ЗаполнитьЗначенияСвойств(НоваяСтрока,эл);  
		   НоваяСтрока.ZUPC_ActualDepartmentName = ZUPC_ActualDepartmentName; 
		   MonthlySalary = СтрЗаменить(эл.MonthlySalary,",","");
		   НоваяСтрока.MonthlySalary = СтрЗаменить(MonthlySalary,"$","");

		   НоваяСтрока.InRubles = СтрЗаменить(эл.InRubles,",","");

			
	    Иначе 
		   ZUPC_ActualDepartmentName =  эл.NO_;    
		КонецЕсли;
		   
	
	КонецЦикла;
	
   Возврат  тРез;
КонецФункции // ПодготовитьТаблицуHR()

